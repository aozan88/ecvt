# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Models (ADR 0005): subagents on Haiku, Manager on Sonnet
ECVT_SUBAGENT_MODEL=claude-haiku-5-5
ECVT_MANAGER_MODEL=claude-sonnet-5-5

# n8n (self-hosted)
N8N_HOST=localhost
N8N_PORT=5678
# n8n → ECVT trigger (M3-T5, setup/n8n.md). Generate the token; never commit it.
ECVT_TRIGGER_TOKEN=
ECVT_TRIGGER_URL=http://host.docker.internal:8090

# Memory / stores
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://ecvt:ecvt@localhost:5432/ecvt

# Plugins (target systems) — filled per plugin
# REST_BASE_URL=
# Where the Manager's execution stage sends requests (default http://localhost:8000)
# ECVT_BASE_URL=http://localhost:8000
