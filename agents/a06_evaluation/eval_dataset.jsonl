{"id": "ev-r01", "category": "happy-path", "scoring": "schema-valid", "input": {"scenario": {"id": "ev-r01", "title": "overdraft", "category": "edge", "rationale": "no minimum balance", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 500.0}}, "expectation": {"expected_status": [400, 422], "expected_behavior": "rejected; balances untouched", "invariants": [], "probes": [{"name": "read_src", "method": "GET", "path": "/accounts/{src}/balance"}, {"name": "read_dst", "method": "GET", "path": "/accounts/{dst}/balance"}]}}, "judge": false}, "rubric": "Validates as a ScenarioScore with verdict fail and defect_suspected true.", "expected_schema": "ecvt.scoring.ScenarioScore"}
{"id": "ev-r02", "category": "happy-path", "scoring": "keyword-match", "input": {"scenario": {"id": "ev-r02", "title": "unknown account", "category": "negative", "rationale": "missing account handling", "setup": [], "action": {"name": "t", "method": "GET", "path": "/accounts/nope/balance"}, "expectation": {"expected_status": [404], "expected_behavior": "404 for unknown account", "invariants": [], "probes": []}}, "judge": false}, "rubric": "Both status_expected and no_server_error fire: a 5xx is a defect regardless of expectation.", "expected_keywords": ["no_server_error", "fail"]}
{"id": "ev-r03", "category": "happy-path", "scoring": "keyword-match", "input": {"scenario": {"id": "ev-r03", "title": "valid transfer", "category": "happy", "rationale": "baseline", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 10.0}}, "expectation": {"expected_status": [200], "expected_behavior": "applied once", "invariants": [], "probes": []}}, "judge": true}, "rubric": "Verdict pass with no judge dimension recorded: the rules settled it and no model call was made.", "expected_keywords": ["\"verdict\": \"pass\""]}
{"id": "ev-r04", "category": "edge-unrunnable-scenario", "scoring": "keyword-match", "input": {"scenario": {"id": "ev-r04", "title": "broken setup", "category": "edge", "rationale": "scenario defect, not a target defect", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "a"}, "save": {"src": "nope"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 10.0}}, "expectation": {"expected_status": [200], "expected_behavior": "n/a", "invariants": [], "probes": []}}, "judge": true}, "rubric": "Verdict not_run and defect_suspected false: a broken scenario is not a defect in the target.", "expected_keywords": ["not_run", "\"defect_suspected\": false"]}
{"id": "ev-r05", "category": "happy-path", "scoring": "keyword-match", "input": {"scenario": {"id": "ev-r05", "title": "replay", "category": "adversarial", "rationale": "no idempotency key", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 10.0}}, "expectation": {"expected_status": [200, 409], "expected_behavior": "applied once only", "invariants": [], "probes": []}, "repeat": 2}, "judge": false}, "rubric": "replay_rejected is inconclusive rather than fail: idempotency correctness is domain-dependent.", "expected_keywords": ["replay_rejected", "inconclusive"]}
{"id": "ev-j01", "category": "happy-path", "scoring": "llm-judge", "input": {"scenario": {"id": "ev-j01", "title": "overdraft with invariant", "category": "edge", "rationale": "no minimum balance", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 500.0}}, "expectation": {"expected_status": [400, 422], "expected_behavior": "rejected; balances untouched", "invariants": ["source balance is still 50.0"], "probes": [{"name": "read_src", "method": "GET", "path": "/accounts/{src}/balance"}, {"name": "read_dst", "method": "GET", "path": "/accounts/{dst}/balance"}]}}, "judge": true}, "rubric": "The judge returns fail and cites the actual negative balance as the evidence for the broken invariant."}
{"id": "ev-j02", "category": "edge-no-evidence", "scoring": "llm-judge", "input": {"scenario": {"id": "ev-j02", "title": "no probes", "category": "happy", "rationale": "invariant with nothing to read it", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 10.0}}, "expectation": {"expected_status": [200], "expected_behavior": "applied once", "invariants": ["the sum of both balances is unchanged"], "probes": []}}, "judge": true}, "rubric": "The judge returns inconclusive for the invariant because no probe read a balance. Fails if it guesses pass."}
{"id": "ev-j03", "category": "happy-path", "scoring": "llm-judge", "input": {"scenario": {"id": "ev-j03", "title": "negative amount", "category": "negative", "rationale": "amount has no lower bound", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": -25.0}}, "expectation": {"expected_status": [422], "expected_behavior": "rejected as invalid", "invariants": ["source balance is still 50.0"], "probes": [{"name": "read_src", "method": "GET", "path": "/accounts/{src}/balance"}, {"name": "read_dst", "method": "GET", "path": "/accounts/{dst}/balance"}]}}, "judge": true}, "rubric": "The judge identifies the direction reversal from the figures (source grew, target went negative), not merely that the status was 200."}
{"id": "ev-j04", "category": "happy-path", "scoring": "llm-judge", "input": {"scenario": {"id": "ev-j04", "title": "exact balance", "category": "edge", "rationale": "float residue on a full transfer", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 50.0}}, "expectation": {"expected_status": [200], "expected_behavior": "source is exactly 0.0 afterwards", "invariants": ["source balance is exactly 0.0"], "probes": [{"name": "read_src", "method": "GET", "path": "/accounts/{src}/balance"}, {"name": "read_dst", "method": "GET", "path": "/accounts/{dst}/balance"}]}}, "judge": true}, "rubric": "The judge weighs the probe figure against 'exactly 0.0' and states what it found; it does not call an unread value a pass."}
{"id": "ev-j05", "category": "negative-wrong-domain", "scoring": "llm-judge", "input": {"scenario": {"id": "ev-j05", "title": "self transfer", "category": "security", "rationale": "from == to not blocked", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{src}", "amount": 10.0}}, "expectation": {"expected_status": [400, 422], "expected_behavior": "self-transfer rejected", "invariants": ["balance unchanged"], "probes": [{"name": "read_src", "method": "GET", "path": "/accounts/{src}/balance"}, {"name": "read_dst", "method": "GET", "path": "/accounts/{dst}/balance"}]}}, "judge": true}, "rubric": "The output describes the deviation and never proposes a code fix."}
{"id": "ev-h01", "category": "happy-path", "scoring": "llm-judge", "input": {"scenario": {"id": "ev-h01", "title": "replay with invariant", "category": "adversarial", "rationale": "no idempotency key", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 10.0}}, "expectation": {"expected_status": [200, 409], "expected_behavior": "applied once only", "invariants": ["source balance is 40.0"], "probes": [{"name": "read_src", "method": "GET", "path": "/accounts/{src}/balance"}, {"name": "read_dst", "method": "GET", "path": "/accounts/{dst}/balance"}]}, "repeat": 2}, "judge": true}, "rubric": "Rules alone are inconclusive; the judge resolves it from the balance after two accepted copies. Combined verdict is fail."}
{"id": "ev-h02", "category": "happy-path", "scoring": "llm-judge", "input": {"scenario": {"id": "ev-h02", "title": "concurrent transfers", "category": "stress", "rationale": "read-modify-write race", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 10.0}}, "expectation": {"expected_status": [200, 409], "expected_behavior": "serialized; no lost update", "invariants": ["the sum of both balances is unchanged"], "probes": [{"name": "read_src", "method": "GET", "path": "/accounts/{src}/balance"}, {"name": "read_dst", "method": "GET", "path": "/accounts/{dst}/balance"}]}, "concurrency": 10}, "judge": true}, "rubric": "The judge uses the lost-update evidence: the source went negative and the pair no longer sums to the starting total."}
{"id": "ev-h03", "category": "happy-path", "scoring": "llm-judge", "input": {"scenario": {"id": "ev-h03", "title": "valid transfer with invariant", "category": "happy", "rationale": "baseline", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 10.0}}, "expectation": {"expected_status": [200], "expected_behavior": "applied once", "invariants": ["the sum of both balances is unchanged"], "probes": [{"name": "read_src", "method": "GET", "path": "/accounts/{src}/balance"}, {"name": "read_dst", "method": "GET", "path": "/accounts/{dst}/balance"}]}}, "judge": true}, "rubric": "Rules pass and the judge passes: 40 plus 10 equals the original 50. Combined verdict pass, defect_suspected false."}
{"id": "ev-h04", "category": "edge-conflicting-signals", "scoring": "llm-judge", "input": {"scenario": {"id": "ev-h04", "title": "huge amount", "category": "stress", "rationale": "no upper bound on amount", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 1000000000000.0}}, "expectation": {"expected_status": [400, 422], "expected_behavior": "absurd amounts rejected", "invariants": ["source balance is still 50.0"], "probes": [{"name": "read_src", "method": "GET", "path": "/accounts/{src}/balance"}, {"name": "read_dst", "method": "GET", "path": "/accounts/{dst}/balance"}]}}, "judge": true}, "rubric": "A FAIL in any dimension carries: the combined verdict is fail even if one dimension found nothing wrong."}
{"id": "ev-h05", "category": "edge-no-evidence", "scoring": "llm-judge", "input": {"scenario": {"id": "ev-h05", "title": "unreadable probe", "category": "happy", "rationale": "state cannot be read back", "setup": [{"name": "mk_src", "method": "POST", "path": "/accounts", "body": {"owner": "alice", "initial_balance": 50.0}, "save": {"src": "id"}}, {"name": "mk_dst", "method": "POST", "path": "/accounts", "body": {"owner": "bob", "initial_balance": 0.0}, "save": {"dst": "id"}}], "action": {"name": "t", "method": "POST", "path": "/transfers", "body": {"from_account": "{src}", "to_account": "{dst}", "amount": 10.0}}, "expectation": {"expected_status": [200], "expected_behavior": "applied once", "invariants": ["source balance is 40.0"], "probes": [{"name": "read_missing", "method": "GET", "path": "/accounts/nope/balance"}]}}, "judge": true}, "rubric": "probes_readable fails and the score records that state could not be read back, so the invariant was never verifiable."}
